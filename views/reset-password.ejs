<%- include('partials/head', { title: 'Reset password' }) %>
<%- include('partials/header') %>
<main class="max-w-md mx-auto px-5 mt-12">
  <h1 class="text-2xl font-bold">Reset password</h1>
  <p class="text-gray-600 text-sm mt-2">Enter your new password.</p>
  <%- include('partials/message') %>
  <form method="POST" action="/reset-password/<%= token %>" class="mt-6">
      <div class="mt-4">
        <label for="password" class="block text-sm font-medium mb-1">New password</label>
        <input id="password" name="password" type="password" minlength="8" required class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-gray-900">
      </div>
      <div class="mt-4">
        <label for="confirmPassword" class="block text-sm font-medium mb-1">Confirm password</label>
        <input id="confirmPassword" name="confirmPassword" type="password" minlength="8" required class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:border-gray-900">
      </div>
    <button type="submit" class="w-full bg-gray-900 text-white rounded py-2.5 mt-6 hover:bg-gray-800">Update password</button>
  </form>
  <p class="text-sm text-gray-600 mt-5 leading-7"><a href="/login" class="underline">Back to login</a></p>
</main>
<%- include('partials/footer') %>
