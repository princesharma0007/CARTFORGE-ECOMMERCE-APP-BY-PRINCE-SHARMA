<%- include('partials/head', { title: 'Dashboard'  }) %>
<%- include('partials/header', { title: 'Dashboard' , user: user }) %>

<main class="max-w-6xl mx-auto px-5 py-10">

  <% if (page === 'dashboard') { %>

    <h1 class="text-3xl font-bold">
      <% if (user) { %>Welcome, <%= user.username %>!<% } else { %>Welcome to CARTFORGE!<% } %>
    </h1>

    <p class="text-gray-600 mt-2">
      Welcome to CARTFORGE.
    </p>

    <div class="flex justify-between items-center mt-10 mb-6">
      <h2 class="text-2xl font-bold">
        Featured Products
      </h2>

      <a href="/products"
         class="bg-gray-900 text-white px-4 py-2 rounded">
        View All Products
      </a>
    </div>

  <% } else if (page === 'products') { %>
<h1 class="text-3xl font-bold mb-6">user: <%= user ? user.username : 'Guest' %></h1>
    <h1 class="text-3xl font-bold mb-6">
      All Products
    </h1>

  <% } %>


  <% if (page === 'dashboard' || page === 'products') { %>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

      <% products.forEach(product => { %>

        <div class="border border-gray-200 rounded-lg p-4">

          <img
            src="<%= product.image %>"
            alt="<%= product.name %>"
            class="w-full h-48 object-contain bg-gray-50 rounded"
          >

          <h3 class="font-bold text-lg mt-4">
            <%= product.name %>
          </h3>

          <p class="text-sm text-gray-500 mt-1">
            <%= product.category %>
          </p>

          <p class="text-sm text-gray-600 mt-2">
            <%= product.description %>
          </p>

          <p class="text-xl font-bold mt-3">
            ₹<%= product.price.toLocaleString('en-IN') %>
          </p>

          <p class="text-sm text-gray-500 mt-2">
            Stock: <%= product.stock %>
          </p>

          <button type="button" onclick="addToCart('<%= product._id %>')"
            class="w-full bg-gray-900 text-white py-2 rounded mt-4 hover:bg-gray-700">
            Add to Cart
          </button>
          <a href="/products/<%= product._id %>"
            class="block text-center w-full border border-gray-900 py-2 rounded mt-4 hover:bg-gray-100">
            View Details
          </a>

        </div>

      <% }) %>

    </div>

    <% if (products.length === 0) { %>
      <p class="text-gray-500 mt-5">
        No products available.
      </p>
    <% } %>

  <% } else if (page === 'cart') { %>

    <h1 class="text-3xl font-bold">
      Your Cart
    </h1>

    <p class="text-gray-600 mt-3">
      Your cart is currently empty.
    </p>

  <% } else if (page === 'profile') { %>

    <h1 class="text-3xl font-bold">
      My Profile
    </h1>

    <div class="max-w-md mt-6 border border-gray-200 rounded p-6 flex items-center gap-4">

      <span class="w-16 h-16 bg-gray-900 text-white rounded-full flex items-center justify-center text-2xl font-bold">
        <%= user.username %>
      </span>

      <div>
        <p class="font-semibold">
          <%= user.username %>
        </p>

        <p class="text-sm text-gray-600">
          <%= user.email %>
        </p>
      </div>

    </div>

  <% } %>

  <% if (user) { %>
  <form method="POST" action="/logout" class="mt-10">
    <button class="border border-gray-900 rounded px-5 py-2 hover:bg-gray-100">
      Log out
    </button>
  </form>
  <% } %>
<script>
  console.log(<%- JSON.stringify(user ? user.username : "Guest") %>);
</script>
</main>

<%- include('partials/footer') %>
